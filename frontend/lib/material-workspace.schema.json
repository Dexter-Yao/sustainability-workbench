          "type": "string"
        },
        "confirmed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pending_description_count": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "status",
        "pending_description_count"
      ],
      "title": "MaterialSetConfirmationProjection",
      "type": "object"
    },
    "MaterialSourceContentProjection": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "format": "uuid",
          "type": "string"
        },
        "normalized_material": {
          "anyOf": [
            {
              "$ref": "#/$defs/NormalizedMaterialProjection"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_id",
        "normalized_material"
      ],
      "title": "MaterialSourceContentProjection",
      "type": "object"
    },
    "MaterialSourceProjection": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "content_type": {
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/MaterialScopeProjection"
        },
        "content_availability": {
          "enum": [
            "available",
            "not_extracted"
          ],
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/MaterialSourceStatus"
