{
  "$defs": {
    "AssertionBasis": {
      "enum": [
        "material_evidence",
        "user_assertion"
      ],
      "type": "string"
    },
    "CertificateFactProjection": {
      "additionalProperties": false,
      "description": "证书事实的用户可见投影；字段与入口解析同名，供资料处理页核对与更正。",
      "properties": {
        "certificate_name": {
          "default": "",
          "type": "string"
        },
        "issuer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "covered_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "holder_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unreadable_fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "CertificateFactProjection",
      "type": "object",
      "required": [
        "unreadable_fields"
      ]
    },
    "ClarificationOptionProjection": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "value",
        "label"
      ],
      "title": "ClarificationOptionProjection",
      "type": "object"
    },
    "DocxParagraphLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "docx_paragraph",
          "default": "docx_paragraph",
          "type": "string"
        },
        "paragraph_index": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "paragraph_index"
      ],
      "title": "DocxParagraphLocator",
      "type": "object"
    },
    "DocxTableLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "docx_table",
          "default": "docx_table",
          "type": "string"
        },
        "table_index": {
          "minimum": 1,
          "type": "integer"
        },
        "row_start": {
          "minimum": 1,
          "type": "integer"
        },
        "row_end": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "table_index",
        "row_start",
        "row_end"
      ],
      "title": "DocxTableLocator",
      "type": "object"
    },
    "ImageRegionLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "image_region",
          "default": "image_region",
          "type": "string"
        },
        "region_label": {
          "default": "整张图片",
          "type": "string"
        },
        "x": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "y": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ImageRegionLocator",
      "type": "object",
      "required": [
        "kind"
      ]
    },
    "MaterialClarificationProjection": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "scope_id": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/ClarificationOptionProjection"
          },
          "type": "array"
        },
        "allow_free_text": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "open",
            "answered",
            "dismissed"
          ],
          "type": "string"
        },
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "scope_id",
        "question",
        "options",
        "allow_free_text",
        "status",
        "created_at"
      ],
      "title": "MaterialClarificationProjection",
      "type": "object"
    },
    "MaterialEvidenceProjection": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "format": "uuid",
          "type": "string"
        },
        "source_name": {
          "type": "string"
        },
        "segment_id": {
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/SourceLocator"
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "source_id",
        "source_name",
        "segment_id",
        "locator"
      ],
      "title": "MaterialEvidenceProjection",
      "type": "object"
    },
    "MaterialFactConfirmationMethod": {
      "enum": [
        "deterministic",
        "user"
      ],
      "type": "string"
    },
    "MaterialFactProjection": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "semantic_key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "scope_id": {
          "type": "string"
        },
        "report_section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ]
        },
        "supplement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "effective_period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rationale": {
          "type": "string"
        },
        "basis": {
          "$ref": "#/$defs/AssertionBasis"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/MaterialEvidenceProjection"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/MaterialFactStatus"
        },
        "confirmation_method": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaterialFactConfirmationMethod"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        },
        "stale_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "semantic_key",
        "label",
        "scope_id",
        "value",
        "rationale",
        "basis",
        "evidence_refs",
        "status",
        "version"
      ],
      "title": "MaterialFactProjection",
      "type": "object"
    },
    "MaterialFactStatus": {
      "enum": [
        "candidate",
        "confirmed",
        "conflicted",
        "rejected",
        "stale"
      ],
      "type": "string"
    },
    "MaterialGapProjection": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "scope_id": {
          "type": "string"
        },
        "report_section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "enum": [
            "missing",
            "conflict",
            "unparseable",
            "needs_judgment"
          ],
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "source_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "open",
            "resolved",
            "dismissed",
            "stale"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "scope_id",
        "kind",
        "title",
        "description",
        "source_ids",
        "status"
      ],
      "title": "MaterialGapProjection",
      "type": "object"
    },
    "MaterialIngressReasonCode": {
      "enum": [
        "admitted",
        "duplicate_reused",
        "duplicate_declaration_conflict",
        "binding_removed",
        "file_rejected",
        "storage_failed",
        "upload_failed"
      ],
      "type": "string"
    },
    "MaterialIngressReceipt": {
      "additionalProperties": false,
      "description": "由准入事实和当前 Source 状态派生的人类可见收据。",
      "properties": {
        "receipt_id": {
          "format": "uuid",
          "type": "string"
        },
        "batch_id": {
          "format": "uuid",
          "type": "string"
        },
        "filename": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/MaterialIngressStatus"
        },
        "reason_code": {
          "$ref": "#/$defs/MaterialIngressReasonCode"
        },
        "source_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        "next_action": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "batch_id",
        "filename",
        "status",
        "reason_code",
        "message",
        "next_action"
      ],
      "title": "MaterialIngressReceipt",
      "type": "object"
    },
    "MaterialIngressStatus": {
      "enum": [
        "accepted",
        "reused",
        "rejected"
      ],
      "type": "string"
    },
    "MaterialKind": {
      "enum": [
        "pdf",
        "docx",
        "xlsx",
        "pptx",
        "png",
        "jpeg",
        "webp"
      ],
      "type": "string"
    },
    "MaterialMessageProjection": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "scope_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "role",
        "content",
        "scope_id",
        "created_at"
      ],
      "title": "MaterialMessageProjection",
      "type": "object"
    },
    "MaterialOptionGroupProjection": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "min_selections": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "key",
        "label",
        "options",
        "min_selections"
      ],
      "title": "MaterialOptionGroupProjection",
      "type": "object"
    },
    "MaterialParseResultProjection": {
      "additionalProperties": false,
      "description": "单份资料的脱敏 parse-first 结果摘要，不携带清洗正文或对象路径。",
      "properties": {
        "status": {
          "enum": [
            "not_started",
            "available",
            "failed"
          ],
          "type": "string"
        },
        "fragment_count": {
          "minimum": 0,
          "type": "integer"
        },
        "fragment_kinds": {
          "items": {
            "enum": [
              "text",
              "table",
              "image_observation"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "fragment_count",
        "fragment_kinds",
        "summary"
      ],
      "title": "MaterialParseResultProjection",
      "type": "object"
    },
    "MaterialProcessingStepProjection": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "route": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "type": "string"
        },
        "quality_flags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "created_at": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "stage",
        "status",
        "quality_flags",
        "created_at"
      ],
      "title": "MaterialProcessingStepProjection",
      "type": "object"
    },
    "MaterialProposalProjection": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "scope_id": {
          "type": "string"
        },
        "report_section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_key": {
          "type": "string"
        },
        "target_label": {
          "type": "string"
        },
        "target_kind": {
          "enum": [
            "text",
            "single_select",
            "multi_select"
          ],
          "type": "string"
        },
        "target_options": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "target_option_groups": {
          "items": {
            "$ref": "#/$defs/MaterialOptionGroupProjection"
          },
          "type": "array"
        },
        "question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "current_answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "current_supplement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "proposed_answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ]
        },
        "proposed_supplement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "basis": {
          "$ref": "#/$defs/AssertionBasis"
        },
        "explanation": {
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/MaterialEvidenceProjection"
          },
          "type": "array"
        },
        "fact_claim_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        "processing_summary": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ProposalStatus"
        },
        "stale_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_value_fingerprint": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "scope_id",
        "target_key",
        "target_label",
        "target_kind",
        "target_options",
        "target_option_groups",
        "proposed_answer",
        "basis",
        "explanation",
        "evidence_refs",
        "fact_claim_ids",
        "processing_summary",
        "status",
        "target_value_fingerprint"
      ],
      "title": "MaterialProposalProjection",
      "type": "object"
    },
    "MaterialScopeProjection": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "profile",
            "topics",
            "uncertain",
            "report"
          ],
          "type": "string"
        },
        "report_section_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "report_section_ids"
      ],
      "title": "MaterialScopeProjection",
      "type": "object"
    },
    "MaterialScopeSummaryProjection": {
      "additionalProperties": false,
      "properties": {
        "scope_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "report_section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_count": {
          "minimum": 0,
          "type": "integer"
        },
        "ready_count": {
          "minimum": 0,
          "type": "integer"
        },
        "pending_proposal_count": {
          "minimum": 0,
          "type": "integer"
        },
        "accepted_proposal_count": {
          "minimum": 0,
          "type": "integer"
        },
        "gap_count": {
          "minimum": 0,
