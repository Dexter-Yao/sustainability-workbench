# Environment template for running the backend locally. Copy to backend/.env and fill it in.
# .env is gitignored and must never be committed.
# Local single-user mode needs only the local Supabase stack (make supabase-up) and a model key.

SUSTAINABILITY_DESK_ENVIRONMENT=local
SUSTAINABILITY_DESK_SUPABASE_PROJECT=sustainability-desk-local
SUSTAINABILITY_DESK_GIT_SHA=unknown

# Local Supabase stack. Run `supabase status` to read the three values below.
SUSTAINABILITY_DESK_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUSTAINABILITY_DESK_SUPABASE_URL=http://127.0.0.1:54321
SUSTAINABILITY_DESK_SUPABASE_JWT_SECRET=<JWT secret from supabase status>
SUSTAINABILITY_DESK_SUPABASE_SERVICE_KEY=<service_role key from supabase status>
SUSTAINABILITY_DESK_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUSTAINABILITY_DESK_PUBLIC_SUPABASE_ANON_KEY=<anon key from supabase status>

# Where report deliverables and observability traces are written.
# Leave both unset to use the in-repo defaults (backend/out/report_artifacts and
# backend/out/observability). If you do set them, the paths **must be absolute** — a relative
# value fails report generation with "must be an absolute path".
# SUSTAINABILITY_DESK_REPORT_ARTIFACT_ROOT=/absolute/path/to/report_artifacts
# SUSTAINABILITY_DESK_OBSERVABILITY_ROOT=/absolute/path/to/observability

# Where uploaded material files are stored. Unset uses the in-repo default
# (backend/out/object-storage); an explicit path **must be absolute**.
# Clear this value to use Supabase Storage instead, which needs the storage-api service running
# (`make supabase-up` excludes it by default).
# SUSTAINABILITY_DESK_LOCAL_STORAGE_ROOT=/absolute/path/to/object-storage

# Passwords for the controlled test accounts, injected for a single run of
# `make provision-test-accounts ARGS=--apply`. The auth stack requires at least 12 characters
# with lowercase, uppercase and digits. Never commit the values.
# SUSTAINABILITY_DESK_INTERNAL_AUTOMATION_PASSWORD=
# SUSTAINABILITY_DESK_INTERNAL_MANUAL_PASSWORD=

# Report generation defaults to Azure OpenAI. The endpoint is not a secret; the key is.
AZURE_OPENAI_API_KEY=<azure-openai-api-key>
AZURE_OPENAI_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com/

# Every model below is optional: the registry already carries the entry, so setting the matching
# key makes that model selectable. Without the key, it is not offered.
# Any OpenAI-compatible service (self-hosted vLLM, Ollama, a proxy gateway, another vendor)
# connects through the generic `openai-compatible` entry — endpoint and model name are read from
# the environment, with no code changes.
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_COMPAT_MODEL_NAME=qwen3:8b

# DASHSCOPE_API_KEY=            # qwen / glm / kimi models on Alibaba Cloud Model Studio
# DEEPSEEK_API_KEY=             # deepseek-chat
# MOONSHOT_API_KEY=             # moonshot-kimi-k2
# ZHIPU_API_KEY=                # zhipu-glm-4.6
# Endpoints of registered vendors can be overridden for a proxy gateway or private deployment:
# DASHSCOPE_BASE_URL= / DEEPSEEK_BASE_URL= / MOONSHOT_BASE_URL= / ZHIPU_BASE_URL=

# Optional: OTLP trace export (OTLP/HTTP). Leave both unset to export nothing; the local JSONL
# traces are written either way. Give the endpoint up to and including /v1/traces, and pass
# HEADERS as comma-separated key=value pairs.
#
# Langfuse (self-hosted or cloud; credentials are the project's public/secret key, base64-encoded):
#   SUSTAINABILITY_DESK_OTLP_TRACES_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces
#   SUSTAINABILITY_DESK_OTLP_TRACES_HEADERS=Authorization=Basic <base64(pk-lf-...:sk-lf-...)>
#
# LangSmith:
#   SUSTAINABILITY_DESK_OTLP_TRACES_ENDPOINT=https://api.smith.langchain.com/otel/v1/traces
#   SUSTAINABILITY_DESK_OTLP_TRACES_HEADERS=x-api-key=<langsmith-api-key>,Langsmith-Project=<project>
#
# Any other OTLP/HTTP backend works the same way; the code branches on no vendor.
# SUSTAINABILITY_DESK_OTLP_TRACES_ENDPOINT=
# SUSTAINABILITY_DESK_OTLP_TRACES_HEADERS=
