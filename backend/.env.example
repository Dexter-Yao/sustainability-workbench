# 后端本机运行的环境变量模板。复制为 backend/.env 后填写；.env 已被 gitignore，不得提交。
# 本机单用户模式只需要本机 Supabase 栈（supabase start）与模型凭据。

SUSTAINABILITY_DESK_ENVIRONMENT=local
SUSTAINABILITY_DESK_SUPABASE_PROJECT=sustainability-desk-local
SUSTAINABILITY_DESK_GIT_SHA=unknown

# 本机 Supabase 栈（supabase start 后 `supabase status` 可读到以下值）。
SUSTAINABILITY_DESK_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUSTAINABILITY_DESK_SUPABASE_URL=http://127.0.0.1:54321
SUSTAINABILITY_DESK_SUPABASE_JWT_SECRET=<supabase status 里的 JWT secret>
SUSTAINABILITY_DESK_SUPABASE_SERVICE_KEY=<supabase status 里的 service_role key>
SUSTAINABILITY_DESK_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUSTAINABILITY_DESK_PUBLIC_SUPABASE_ANON_KEY=<supabase status 里的 anon key>

# 报告交付物与内部审计包的私有目录；观测轨迹（JSONL）的落盘根目录。
# 两项都可留空：留空即用仓库内默认（backend/out/report_artifacts、backend/out/observability）。
# 交付物根若要显式指定，**必须是绝对路径**——相对值会让报告生成以
# 「SUSTAINABILITY_DESK_REPORT_ARTIFACT_ROOT 必须是绝对路径」失败。
# SUSTAINABILITY_DESK_REPORT_ARTIFACT_ROOT=/absolute/path/to/report_artifacts
# SUSTAINABILITY_DESK_OBSERVABILITY_ROOT=/absolute/path/to/observability

# 受控测试账号的密码，供 `make provision-test-accounts ARGS=--apply` 建号时注入单次进程。
# 认证栈要求至少 12 位且同时含小写、大写与数字（supabase/config.toml 的
# minimum_password_length 与 password_requirements）。值不得提交。
# SUSTAINABILITY_DESK_INTERNAL_AUTOMATION_PASSWORD=
# SUSTAINABILITY_DESK_INTERNAL_MANUAL_PASSWORD=

# 报告生成默认走 Azure OpenAI（部署名见 llm/model_registry.py）。
# 端点不是密钥，密钥不得入库。
AZURE_OPENAI_API_KEY=<azure-openai-api-key>
AZURE_OPENAI_ENDPOINT=https://<资源名>.cognitiveservices.azure.com/

# 以下模型均为可选：注册表已登记条目，配好对应密钥即可选用，不配则该模型不可用。
# 任一 OpenAI 兼容服务（自建 vLLM / Ollama / 代理网关 / 其他厂商）用通用条目 openai-compatible 接入，
# 端点与模型名都从环境变量读，无需改代码。
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_COMPAT_MODEL_NAME=qwen3:8b

# DASHSCOPE_API_KEY=            # 阿里云百炼上的 qwen / glm / kimi 候选模型
# DEEPSEEK_API_KEY=             # deepseek-chat
# MOONSHOT_API_KEY=             # moonshot-kimi-k2
# ZHIPU_API_KEY=                # zhipu-glm-4.6
# 已登记服务商的端点也可覆盖，用于代理网关或私有部署：
# DASHSCOPE_BASE_URL= / DEEPSEEK_BASE_URL= / MOONSHOT_BASE_URL= / ZHIPU_BASE_URL=

# 可选：OTLP 链路导出（OTLP/HTTP）。两项都留空即不导出，本地 JSONL 仍是真相源——
# 导出只是同一份轨迹的镜像投影，不接任何后端也不影响产品功能。
# 端点填到 /v1/traces 为止；HEADERS 用逗号分隔的 key=value。
#
# Langfuse（自建或云端，凭据取自项目设置里的 public/secret key，需 base64 编码）：
#   SUSTAINABILITY_DESK_OTLP_TRACES_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces
#   SUSTAINABILITY_DESK_OTLP_TRACES_HEADERS=Authorization=Basic <base64(pk-lf-...:sk-lf-...)>
#
# LangSmith：
#   SUSTAINABILITY_DESK_OTLP_TRACES_ENDPOINT=https://api.smith.langchain.com/otel/v1/traces
#   SUSTAINABILITY_DESK_OTLP_TRACES_HEADERS=x-api-key=<langsmith-api-key>,Langsmith-Project=<project>
#
# 其他兼容 OTLP/HTTP 的后端同理；代码不对任何厂商做分支。
# SUSTAINABILITY_DESK_OTLP_TRACES_ENDPOINT=
# SUSTAINABILITY_DESK_OTLP_TRACES_HEADERS=
